# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# LLM providers
# Set the key(s) matching the providers configured in config/defaults.yaml.
# Defaults: chat_agent -> anthropic, image_analyzer -> google.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Google OAuth (web app only — required to start server.py; not needed for
# the CLI in main.py). Create credentials at https://console.cloud.google.com/
# under "APIs & Services" > "Credentials" > "OAuth client ID" (Web application),
# and add GOOGLE_REDIRECT_URI below as an authorized redirect URI.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------------------------------------------------------------------------
# JWT signing secret (web app only — required to start server.py).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# Database location (web app only — required to start server.py, no default).
# Today this is a local SQLite file path; it's intentionally required rather
# than defaulted because it will point at a cloud database connection string
# later, and we don't want that swap to be silent.
#
# The app never auto-creates this file. Provision it once before first run:
#   ./scripts/init_db.sh
# (reads DB_PATH from this file automatically once you've copied it to .env)
#
# Must be a RELATIVE path (e.g. "splitpro.db"), not absolute. docker-compose.yml
# bind-mounts this exact path into the container, and Compose's short volume
# syntax only resolves a relative host path correctly with the "./" prefix
# it uses internally — an absolute DB_PATH breaks that mount.
# ---------------------------------------------------------------------------
DB_PATH=splitpro.db
